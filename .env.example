# ── Claude API ─────────────────────────────────────────────
# https://platform.claude.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...
# 무료 맛보기용 모델 (기본 haiku, 품질 올리려면 claude-sonnet-5)
FREE_MODEL=claude-haiku-4-5
# 유료 리포트용 모델
PAID_MODEL=claude-opus-4-8

# ── Supabase Postgres ──────────────────────────────────────
# Supabase 대시보드 > Connect > Transaction pooler (포트 6543) 문자열 사용
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ── 토스페이먼츠 ────────────────────────────────────────────
# 개발: 테스트 키 (test_ck_/test_sk_) — https://developers.tosspayments.com
# 라이브 전환: 사업자등록 + 토스 심사 후 live_ 키로 교체만 하면 됨
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# ── 카카오 공유 ─────────────────────────────────────────────
# https://developers.kakao.com > 앱 생성 > JavaScript 키, 플랫폼에 도메인 등록
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 사이트 ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
